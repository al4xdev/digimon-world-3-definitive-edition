// The updater's resources (launcher/CMakeLists.txt): the launcher's manifest (UTF-8 code page, long paths) and version
// information. No icon: it has no window.
#include <winver.h>

1 24 "@DW3_RC_DIR@/dw2003-launcher.manifest"

1 VERSIONINFO
FILEVERSION @DW3_RC_NUM@
PRODUCTVERSION @DW3_RC_NUM@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "al4xdev"
            VALUE "FileDescription", "Digimon World 3 launcher updater"
            VALUE "FileVersion", "@DW3_LAUNCHER_VERSION@"
            VALUE "InternalName", "dw2003-updater"
            VALUE "OriginalFilename", "dw2003-updater.exe"
            VALUE "ProductName", "Digimon World 3: Definitive Edition"
            VALUE "ProductVersion", "@DW3_LAUNCHER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
