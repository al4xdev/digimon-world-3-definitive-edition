# The ARM 32-bit cross toolchain for the RK3326 handhelds and PortMaster CFWs (EmuELEC, ArkOS, AmberELEC, ROCKNIX,
# muOS, Knulli). tools/build_arm.sh builds this image on first use (and CI builds it with Docker layer caching) and runs
# CMake and Ninja inside it, so nothing is installed on the host.
#
# Debian 10 (buster, archive.debian.org) provides arm-linux-gnueabihf gcc-8 and armhf multiarch SDL2/EGL/GLES/GBM/DRM
# headers against glibc 2.28, so the resulting armhf binaries run on ArkOS / older EmuELEC (glibc 2.30) and TrimUI
# (glibc 2.33) as well as newer CFWs (AmberELEC/muOS/Knulli 2.38, ROCKNIX 2.40).
FROM debian:buster-slim

ARG CMAKE_VERSION=3.28.3

RUN sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g; /buster-updates/d' /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
    dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ninja-build \
        make \
        python3 \
        pkg-config:armhf \
        gcc-arm-linux-gnueabihf \
        binutils-arm-linux-gnueabihf \
        libc6-dev:armhf \
        libsdl2-dev:armhf \
        libegl1-mesa-dev:armhf \
        libgles2-mesa-dev:armhf \
        libgbm-dev:armhf \
        libdrm-dev:armhf && \
    curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" | \
        tar -xz --strip-components=1 -C /usr/local && \
    apt-get purge -y --auto-remove curl && \
    rm -rf /var/lib/apt/lists/*
