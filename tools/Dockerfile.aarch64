# The ARM 64-bit cross toolchain for aarch64 PortMaster CFWs (TrimUI Stock/CrossMix, dArkOS 64-bit, Knulli,
# ROCKNIX, muOS, EmuELEC, ArkOS, AmberELEC).
#
# Debian 10 (buster, archive.debian.org) provides aarch64-linux-gnu gcc-8 and arm64 multiarch SDL2/EGL/GLES/GBM/DRM
# headers against glibc 2.28, so the resulting aarch64 binaries run across ArkOS/EmuELEC (glibc 2.30), TrimUI
# (glibc 2.33), AmberELEC/muOS/Knulli (glibc 2.38), and ROCKNIX (glibc 2.40).
FROM debian:buster-slim

ARG CMAKE_VERSION=3.28.3

RUN sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g; /buster-updates/d' /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
    dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ninja-build \
        make \
        python3 \
        pkg-config:arm64 \
        gcc-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu \
        libc6-dev:arm64 \
        libsdl2-dev:arm64 \
        libegl1-mesa-dev:arm64 \
        libgles2-mesa-dev:arm64 \
        libgbm-dev:arm64 \
        libdrm-dev:arm64 && \
    curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" | \
        tar -xz --strip-components=1 -C /usr/local && \
    apt-get purge -y --auto-remove curl && \
    rm -rf /var/lib/apt/lists/*
