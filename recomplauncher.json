{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Digimon World 3: Definitive Edition",
  "repo": "al4xdev/digimon-world-3-definitive-edition",
  "game": {
    "kind": "iso",
    "label": "Your disc image (.bin) of Digimon World 2003 (Europe), serial SLES-03936, the Redump dump: this page marks it \"Matches the verified Europe disc\". Other dumps and patched images are refused when the game starts.",
    "check": {
      "iso9660": "SLES_039.36",
      "ids": ["SLES-03936", "SLES_039.36"]
    },
    "dumps": [
      {
        "name": "Europe",
        "size": 692146560,
        "crc32": "007df18e"
      }
    ]
  },
  "start": {
    "program": ["dw2003-launcher.exe", "usr/bin/dw2003-launcher", "dw2003-launcher", "dw2003.AppImage", "AppRun"]
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [
        { "path": "{data}/settings.json", "if": "/etc/os-release" },
        { "path": "{install}/settings.json", "if": "{install}/portable.txt" },
        { "path": "{config}/dw2003/settings.json" }
      ],
      "game_path": "disc/path",
      "ensure": { "schema": "1" }
    }
  ],
  "folders": {
    "saves": [
      { "path": "{data}", "if": "/etc/os-release" },
      { "path": "{install}", "if": "{install}/portable.txt" },
      { "path": "{config}/dw2003" }
    ],
    "logs": [
      { "path": "{data}/logs", "if": "/etc/os-release" },
      { "path": "{install}/logs", "if": "{install}/portable.txt" },
      { "path": "{config}/dw2003/logs" }
    ]
  },
  "saves": [
    "{install}/recomp",
    "{data}/recomp",
    "{local}/dw2003/recomp",
    "{config}/dw2003/recomp",
    "{install}/usr/bin/recomp"
  ],
  "exit_codes": {
    "1": "It stopped before the game could run. If it's the disc: the game plays only the Redump dump of the Europe release (SLES-03936), the one this page marks \"Matches the verified Europe disc\".",
    "4": "The game stopped responding.",
    "64": "A setting or a launch option was not accepted. Pick the disc again on the game's page."
  },
  "looks": {
    "allowed": false,
    "reason": "This recomp already has its own filters, and it draws with SDL_GPU rather than a single API ReShade can sit on."
  },
  "groups": [
    { "id": "Launcher" },
    { "id": "Video" },
    { "id": "Game" },
    { "id": "Debug" }
  ],
  "settings": [
    {
      "id": "launcher_menu",
      "label": "Launcher menu",
      "group": "Launcher",
      "in": "args",
      "help": "Skip starts the game at once. The cloud sync and the save backups still run, and a save conflict still asks.",
      "choices": [
        { "label": "Show", "args": [] },
        { "label": "Skip", "args": ["--play"] }
      ]
    },
    {
      "id": "widescreen",
      "label": "Widescreen",
      "group": "Video",
      "help": "Battles and field fill 16:9 (auto-selects GPU). Menus stay 4:3.",
      "choices": [
        { "label": "Off", "set": { "mods/widescreen/enabled": "false" } },
        { "label": "On", "set": { "mods/widescreen/enabled": "true", "video/renderer": "\"gpu\"" } }
      ],
      "defaults": { "mods/widescreen/enabled": "true" }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "group": "Video",
      "help": "Open the game in fullscreen (F11 also toggles).",
      "choices": [
        { "label": "Off", "set": { "video/fullscreen": "false" } },
        { "label": "On", "set": { "video/fullscreen": "true" } }
      ],
      "defaults": { "video/fullscreen": "false" }
    },
    {
      "id": "scaling",
      "label": "Scaling",
      "group": "Video",
      "help": "Fill stretches cleanly to screen height; Integer uses exact multiples.",
      "choices": [
        { "label": "Integer", "set": { "video/fill": "false" } },
        { "label": "Fill", "set": { "video/fill": "true" } }
      ],
      "defaults": { "video/fill": "true" }
    },
    {
      "id": "window_scale",
      "label": "Window scale",
      "group": "Video",
      "help": "Window resolution scale. The launcher's Auto writes what fits the monitor.",
      "defaults": { "video/scale": "3" },
      "slider": { "key": "video/scale", "min": 2, "max": 8, "step": 1, "format": "%d" }
    },
    {
      "id": "renderer",
      "label": "Renderer",
      "group": "Video",
      "help": "GPU enables widescreen and shaders; Software is exact PS1.",
      "choices": [
        { "label": "GPU", "set": { "video/renderer": "\"gpu\"" } },
        { "label": "Software", "set": { "video/renderer": "\"software\"", "mods/widescreen/enabled": "false" } }
      ],
      "defaults": { "video/renderer": "\"gpu\"" }
    },
    {
      "id": "filter",
      "label": "Filter",
      "group": "Video",
      "help": "GPU screen filter (Sharp keeps crisp pixels).",
      "when": { "video/renderer": "gpu" },
      "choices": [
        { "label": "None", "set": { "video/filter": "\"none\"" } },
        { "label": "Sharp", "set": { "video/filter": "\"sharp\"" } },
        { "label": "Scanlines", "set": { "video/filter": "\"scanlines\"" } },
        { "label": "CRT", "set": { "video/filter": "\"crt\"" } },
        { "label": "Smooth", "set": { "video/filter": "\"smooth\"" } }
      ],
      "defaults": { "video/filter": "\"sharp\"", "video/renderer": "\"gpu\"" }
    },
    {
      "id": "language",
      "label": "Language",
      "group": "Game",
      "help": "Game text language.",
      "choices": [
        { "label": "English", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"english\"" } },
        { "label": "Português (BR)", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"portuguese\"" } },
        { "label": "Français", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"french\"" } },
        { "label": "Deutsch", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"german\"" } },
        { "label": "Italiano", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"italian\"" } },
        { "label": "Español", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"spanish\"" } },
        { "label": "English (USA)", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"usa\"" } },
        { "label": "Japanese", "set": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"japanese\"" } }
      ],
      "defaults": { "mods/preset_language/enabled": "true", "mods/preset_language/language": "\"english\"" }
    },
    {
      "id": "fast_forward",
      "label": "Fast-forward",
      "group": "Game",
      "help": "How fast the fast-forward button runs the game.",
      "choices": [
        { "label": "Off", "set": { "mods/fast_forward/enabled": "false" } },
        { "label": "2x", "set": { "mods/fast_forward/enabled": "true", "mods/fast_forward/speed": "\"2x\"" } },
        { "label": "4x", "set": { "mods/fast_forward/enabled": "true", "mods/fast_forward/speed": "\"4x\"" } },
        { "label": "8x", "set": { "mods/fast_forward/enabled": "true", "mods/fast_forward/speed": "\"8x\"" } },
        { "label": "Unlimited", "set": { "mods/fast_forward/enabled": "true", "mods/fast_forward/speed": "\"unlimited\"" } }
      ],
      "defaults": { "mods/fast_forward/enabled": "true", "mods/fast_forward/speed": "\"8x\"" }
    },
    {
      "id": "fast_load",
      "label": "Fast load",
      "group": "Game",
      "help": "Reads the game's files faster. Movies keep normal speed.",
      "choices": [
        { "label": "Off", "set": { "mods/fast_loading/enabled": "false" } },
        { "label": "2x", "set": { "mods/fast_loading/enabled": "true", "mods/fast_loading/speed": "\"2x\"" } },
        { "label": "4x", "set": { "mods/fast_loading/enabled": "true", "mods/fast_loading/speed": "\"4x\"" } },
        { "label": "8x", "set": { "mods/fast_loading/enabled": "true", "mods/fast_loading/speed": "\"8x\"" } },
        { "label": "Instant", "set": { "mods/fast_loading/enabled": "true", "mods/fast_loading/speed": "\"instant\"" } }
      ],
      "defaults": { "mods/fast_loading/enabled": "true", "mods/fast_loading/speed": "\"8x\"" }
    },
    {
      "id": "skip_dialogues",
      "label": "Skip dialogues",
      "group": "Game",
      "help": "Dialogue boxes close on their own.",
      "choices": [
        { "label": "Off", "set": { "mods/skip_dialogues/enabled": "false" } },
        { "label": "On", "set": { "mods/skip_dialogues/enabled": "true" } }
      ],
      "defaults": { "mods/skip_dialogues/enabled": "false" }
    },
    {
      "id": "skip_battle_animations",
      "label": "Skip battle animations",
      "group": "Game",
      "help": "Battle moves play without their animation.",
      "choices": [
        { "label": "Off", "set": { "mods/battle_animations/enabled": "false", "mods/battle_animations/hit_reaction": "false" } },
        { "label": "On", "set": { "mods/battle_animations/enabled": "true" } }
      ],
      "defaults": { "mods/battle_animations/enabled": "false" }
    },
    {
      "id": "hit_reaction",
      "label": "Hit reaction",
      "group": "Game",
      "help": "Keep the hit flinch while animations are skipped.",
      "when": { "mods/battle_animations/enabled": "true" },
      "choices": [
        { "label": "Off", "set": { "mods/battle_animations/hit_reaction": "false" } },
        { "label": "On", "set": { "mods/battle_animations/hit_reaction": "true" } }
      ],
      "defaults": { "mods/battle_animations/hit_reaction": "false" }
    },
    {
      "id": "battle_text",
      "label": "Battle text",
      "group": "Game",
      "help": "Skip closes battle message boxes so combat flows.",
      "choices": [
        { "label": "Off", "set": { "mods/battle_text/enabled": "true", "mods/battle_text/mode": "\"off\"" } },
        { "label": "Skip", "set": { "mods/battle_text/enabled": "true", "mods/battle_text/mode": "\"skip\"" } },
        { "label": "Async", "set": { "mods/battle_text/enabled": "true", "mods/battle_text/mode": "\"async\"" } }
      ],
      "defaults": { "mods/battle_text/enabled": "true", "mods/battle_text/mode": "\"skip\"" }
    },
    {
      "id": "logs",
      "label": "Logs",
      "group": "Debug",
      "help": "A bug report is easier with Logs on Heavy and the zip attached.",
      "choices": [
        { "label": "Off", "set": { "debug/logs": "\"off\"" } },
        { "label": "Soft", "set": { "debug/logs": "\"soft\"" } },
        { "label": "Heavy", "set": { "debug/logs": "\"heavy\"" } }
      ],
      "defaults": { "debug/logs": "\"off\"" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your memory cards and settings.", "open": "saves" },
    { "id": "logs", "label": "Logs", "help": "The last run's log, for a bug report.", "open": "logs" }
  ]
}
