{
  "name": "dw3-cloud-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "db:migrate:local": "wrangler d1 execute dw3-cloud-sync-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute dw3-cloud-sync-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250411.0",
    "typescript": "^5.8.3"
  }
}
