# CMake toolchain file for cross-compiling to ARM 64-bit (aarch64 PortMaster handhelds)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(ARM64_TRIPLE "aarch64-linux-gnu")
find_program(CMAKE_C_COMPILER NAMES ${ARM64_TRIPLE}-gcc REQUIRED)
find_program(CMAKE_OBJCOPY NAMES ${ARM64_TRIPLE}-objcopy REQUIRED)
find_program(CMAKE_OBJDUMP NAMES ${ARM64_TRIPLE}-objdump REQUIRED)
find_program(CMAKE_NM NAMES ${ARM64_TRIPLE}-nm REQUIRED)
find_program(CMAKE_STRIP NAMES ${ARM64_TRIPLE}-strip REQUIRED)

set(CMAKE_MAKE_PROGRAM /usr/bin/ninja CACHE FILEPATH "" FORCE)
set(PSXSTACK_OBJCOPY "${CMAKE_OBJCOPY}" CACHE FILEPATH "" FORCE)
set(PSXSTACK_OBJDUMP "${CMAKE_OBJDUMP}" CACHE FILEPATH "" FORCE)

# Generic ARMv8-A covers RK3326 (Cortex-A35), H700/A133P (Cortex-A53), RK3566 (Cortex-A55), and S922X/SD865.
set(CMAKE_C_FLAGS_INIT "-march=armv8-a")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
